node_modules/
.next/
.next-dev/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Secrets — never commit. The wildcard covers .env.bak, .env.vercel and
# anything else that ends up holding a connection string; .env.example is the
# one deliberate exception, and holds no values.
.env
.env.*
!.env.example

# Local database
prisma/*.db
prisma/*.db-journal

# Simulated Drive / Canva state (DRIVE_MODE=mock, CANVA_MODE=mock)
.mock-drive/
.mock-canva/

# Metadata dumps from `npm run backup`. They hold no credentials, but they do
# hold every member's address — keep them out of the repository.
backups/

.DS_Store
*.log
