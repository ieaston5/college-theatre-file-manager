// Penn Players Hub — data model
//
// Provider notes: SQLite is used for the private/local environment. Prisma does
// not support enums or native JSON on SQLite, so every enum-ish column is a
// String validated by zod in lib/constants.ts, and structured payloads are
// stored as JSON text. That keeps the schema portable to Postgres (Pass 3)
// without a rewrite.

/// relationJoins makes Prisma fetch a record and its relations in one SQL
/// statement rather than one statement per relation. Every document list on
/// the hub includes the category, the production, the creator and the tags, so
/// each list was five round trips to the database instead of one — and against
/// a hosted Postgres a round trip costs tens of milliseconds whatever the query
/// does. It is still a Prisma preview feature, but a long-standing one, it is
/// only enabled for PostgreSQL, and the results it returns here are identical
/// to the old strategy's, ordering included.
///
/// engineType = "client" builds a client that compiles queries itself and
/// talks to Postgres through node-postgres, instead of shipping Prisma's
/// native query engine. The engine is a 17.5 MB binary that was being copied
/// into the serverless function of every one of the hub's forty routes and
/// started afresh on every cold instance; the compiler that replaces it is
/// under 2 MB. It needs the driver adapter that lib/db sets up — read the note
/// there before changing the connection string, because a couple of the
/// parameters in it mean different things to node-postgres than they did to
/// the engine.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations bypass the pooler; the app does not.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

/// A person allowed to use the hub. A row must exist before someone can sign
/// in — that is the access gate. `status` INVITED means "row created by an
/// admin, has never signed in yet".
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  position    String? // board position, e.g. "Production Manager"
  avatarUrl   String?
  role        String    @default("MEMBER") // ADMIN | BOARD | MEMBER | COMPANY
  status      String    @default("INVITED") // INVITED | ACTIVE | DISABLED
  googleSub   String?   @unique
  invitedById String?
  lastLoginAt DateTime?
  /// Opts out of the weekly digest. Transactional mail — you have been added,
  /// something private was shared with you — is always sent.
  digestOptOut Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  documents      Document[]      @relation("DocumentCreator")
  shares         DocumentShare[] @relation("ShareGrantee")
  grantedShares  DocumentShare[] @relation("ShareGrantor")
  auditLogs      AuditLog[]
  connectedDrive DriveAccount[]
  uploads        PendingUpload[]
  memberships    ProductionMember[] @relation("MembershipUser")
  addedMembers   ProductionMember[] @relation("MembershipAddedBy")
  connectedCanva CanvaAccount[]
  importBatches  ImportBatch[]
  accessRequests AccessRequest[] @relation("AccessRequester")
  accessDecisions AccessRequest[] @relation("AccessDecider")
  checklistTicks ChecklistItem[]

  @@index([role])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Organisation of information
// ---------------------------------------------------------------------------

/// A show. Documents optionally hang off one of these.
model Production {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  abbreviation  String? // used in Drive file names, e.g. "URINETOWN"
  season        String? // e.g. "Fall 2026"
  status        String    @default("PLANNING") // PLANNING | ACTIVE | CLOSED | ARCHIVED
  venue         String?
  synopsis      String?
  opensOn       DateTime?
  closesOn      DateTime?
  color         String? // hex, for dashboard accents
  driveFolderId String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents Document[]
  members   ProductionMember[]
  checklist ChecklistItem[]

  @@index([status])
}

/// A kind of information — "Budgets", "Rehearsal Schedules", "Contact Sheets".
/// This is the primary axis of the dashboard.
model Category {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  icon              String   @default("folder") // key into components/icons.tsx
  color             String   @default("#6366f1")
  /// PRODUCTION = always tied to a show, STANDING = org-wide, BOTH = either.
  scope             String   @default("BOTH")
  defaultDocType    String? // DOC | SHEET | SLIDES
  defaultVisibility String   @default("BOARD") // PRIVATE | BOARD | COMPANY
  /// Whether documents here may be shared with a production's company at all.
  /// Off means the category is board-only and never offered as "Company",
  /// which is what keeps budgets and casting away from the cast.
  companyVisible    Boolean  @default(false)
  /// The edit level new documents here start at: CREATOR_ONLY | BOARD | COMPANY.
  defaultEditAccess String   @default("BOARD")
  folderName        String? // Drive subfolder name; defaults to `name`
  /// Comma-separated words that suggest a file belongs here, used to guess a
  /// category when importing an existing pile of Drive files.
  keywords          String?
  sortOrder         Int      @default(0)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documents        Document[]
  templates        Template[]
  productionRoles  ProductionRole[]
  checklistItems   ChecklistItem[]
  checklistTemplates ChecklistTemplateItem[]

  @@index([archived])
}

/// A Google file that new documents can be copied from.
model Template {
  id           String   @id @default(cuid())
  name         String
  description  String?
  docType      String // DOC | SHEET | SLIDES
  googleFileId String
  categoryId   String?
  sortOrder    Int      @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  documents Document[]
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id          String  @id @default(cuid())
  /// The name everything shows: the hub's naming rule applied to `baseTitle`.
  /// Stored rather than composed on read so that lists, search and sorting
  /// all work on the same string the person sees.
  title       String
  /// What the document is actually called, before the rule: what somebody
  /// typed, or the tidied file name an import found. The rule is always
  /// re-applied from this, so re-filing a document — or an admin changing the
  /// rule — recomposes the name instead of stacking prefixes onto it.
  baseTitle   String
  description String?

  /// DOC | SHEET | SLIDES | FORM | PDF | FOLDER | OTHER | LINK
  docType String
  /// CREATED (born in the hub) | REGISTERED (pre-existing Drive file) | LINK (non-Drive URL)
  source  String  @default("CREATED")
  /// PRIVATE = creator only.
  /// BOARD    = everyone with hub access (shared with the board group).
  /// COMPANY  = the board plus the production's company, filtered by what
  ///            each company member's production role is allowed to see.
  visibility  String  @default("BOARD")
  status      String  @default("ACTIVE") // ACTIVE | ARCHIVED
  pinned      Boolean @default(false)
  /// Who may change the file's *contents* in Google, as opposed to who may see
  /// it. Always a subset of `visibility`.
  ///
  /// CREATOR_ONLY — only the person who filed it (plus anyone named on it).
  /// BOARD        — the board can edit; a company that can see it still reads.
  /// COMPANY      — everyone who can see it can edit it.
  ///
  /// Hub curation — category, production, visibility, deletion — is not
  /// governed by this. It stays with the creator and admins, so an editor can
  /// never widen who sees something.
  editAccess  String  @default("BOARD")

  googleFileId      String?   @unique
  webViewLink       String?
  driveFolderId     String?
  driveOwnerEmail   String?
  /// Bytes, for uploaded, imported and mirrored files.
  ///
  /// BigInt rather than Int: uploads through the hub are capped at 100 MB,
  /// but a registered or imported file is whatever Drive already holds, and
  /// a rehearsal video clears the 2 GB ceiling of a 32-bit integer easily.
  sizeBytes         BigInt?
  /// The name of the file as the uploader had it on their machine.
  originalFileName  String?
  mimeType          String?
  googleModifiedAt  DateTime?
  lastSyncedAt      DateTime?
  /// When the document itself last changed, as opposed to when the hub's row
  /// did: Google's modified time wherever the hub knows it, and the row's own
  /// timestamp for the things Google has never seen (external links, a Canva
  /// design with no export yet). Denormalised into its own indexed column
  /// because it is the default sort for every list, and `COALESCE` of two
  /// columns is not something an index can serve.
  lastEditedAt      DateTime  @default(now())
  /// When the hub last pushed this document's permissions to Drive.
  sharingSyncedAt   DateTime?

  /// Canva mirrors: the hub keeps an exported copy of a Canva design in Drive
  /// so the hub's own permission model applies to it. Canva's API cannot set
  /// per-person access on a design, so mirroring is the only way to put Canva
  /// content behind Company/Board/Private.
  canvaDesignId        String?
  canvaUrl             String?
  canvaTitle           String?
  canvaExportFormat    String? // pdf | pptx
  canvaExportedAt      DateTime?
  /// `updated_at` from Canva at the last check — compared with canvaExportedAt
  /// to tell people the copy here is behind the original.
  canvaDesignUpdatedAt DateTime?
  canvaCheckedAt       DateTime?
  /// Free-form JSON text of extra fields captured at creation time.
  metadata          String?

  categoryId   String
  productionId String?
  creatorId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   Category        @relation(fields: [categoryId], references: [id])
  production Production?     @relation(fields: [productionId], references: [id], onDelete: SetNull)
  creator    User            @relation("DocumentCreator", fields: [creatorId], references: [id])
  tags           Tag[]
  shares         DocumentShare[]
  uploads        PendingUpload[]
  importItems    ImportItem[]
  accessRequests AccessRequest[]

  @@index([categoryId])
  @@index([productionId])
  @@index([creatorId])
  @@index([visibility])
  @@index([status])
  @@index([updatedAt])
  @@index([lastEditedAt])
  @@index([canvaDesignId])
}

/// An individual grant on top of a document's visibility. Used to let a
/// private document be shown to one or two specific people.
model DocumentShare {
  id           String   @id @default(cuid())
  documentId   String
  userId       String
  grantedById  String?
  accessLevel  String   @default("READER") // READER | WRITER
  drivePermId  String?
  createdAt    DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User     @relation("ShareGrantee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?    @relation("ShareGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([documentId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Production companies
// ---------------------------------------------------------------------------

/// A job on a show — "Cast", "Lighting", "Stage management". The categories
/// attached to it are exactly what someone with that role can see, so an actor
/// gets the schedule and the script while a designer also gets design & tech.
/// Admin-editable: the board decides what each role needs.
model ProductionRole {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Pre-selected when adding people, so the common case is one click.
  isDefault   Boolean  @default(false)
  /// Whether this role may file documents on the hub. Off for cast; the case
  /// it exists for is stage management, who file a rehearsal report nightly
  /// and should not need a board account to do it. Even when on, they can
  /// only file into their own categories, on their own shows, and never at
  /// board visibility.
  canCreate   Boolean  @default(false)
  sortOrder   Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  members    ProductionMember[]

  @@index([archived])
}

/// Somebody working on one show. Access comes from the role; `title` is just
/// what they are called on the programme ("Ensemble", "Lighting Designer").
model ProductionMember {
  id           String   @id @default(cuid())
  productionId String
  userId       String
  roleId       String?
  title        String?
  status       String   @default("ACTIVE") // ACTIVE | REMOVED
  addedById    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  production Production      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  user       User            @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role       ProductionRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  addedBy    User?           @relation("MembershipAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([productionId, userId])
  @@index([userId])
  @@index([productionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Asking for access
// ---------------------------------------------------------------------------

/// Somebody asking to be let into a document they cannot see.
///
/// The requester is never told anything about the document — the page they
/// land on is identical whether the id exists or not — but the owner gets a
/// request they can grant in one click.
model AccessRequest {
  id           String   @id @default(cuid())
  documentId   String
  userId       String
  message      String?
  status       String   @default("PENDING") // PENDING | GRANTED | DECLINED
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User     @relation("AccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("AccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([documentId, userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Per-show checklists
// ---------------------------------------------------------------------------

/// The standard list of things every show needs, editable by admins. Copied
/// onto a production when it is created, so changing the template never
/// rewrites a show already in progress.
model ChecklistTemplateItem {
  id         String   @id @default(cuid())
  label      String
  /// When set, the item completes itself as soon as anything is filed in that
  /// category for the show — the checklist tracks the work, not the ticking.
  categoryId String?
  hint       String?
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model ChecklistItem {
  id           String    @id @default(cuid())
  productionId String
  label        String
  categoryId   String?
  hint         String?
  sortOrder    Int       @default(0)
  /// Manual completion. Category-linked items also complete on their own.
  done         Boolean   @default(false)
  doneAt       DateTime?
  doneById     String?
  createdAt    DateTime  @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  doneBy     User?      @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([productionId])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

/// Every message the hub has sent or would have sent.
///
/// Kept for two reasons: while email is off (or the hub is running on the
/// simulated Drive) messages are recorded instead of sent, so the whole flow
/// is reviewable without a Google connection; and in production it is a
/// straight audit trail of what the hub told people.
model EmailMessage {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  /// WELCOME_BOARD | WELCOME_COMPANY | SHARE | DIGEST
  kind      String
  /// LOGGED (email off) | SENT | FAILED
  status    String   @default("LOGGED")
  error     String?
  /// The document, production or user the message is about.
  relatedId String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Importing what already exists
// ---------------------------------------------------------------------------

/// One sweep of an existing Drive folder. Kept as a row because triaging a
/// couple of hundred files is an hour of work done across several sittings —
/// it has to survive a reload.
model ImportBatch {
  id                String   @id @default(cuid())
  sourceFolderId    String
  sourceFolderName  String?
  includeSubfolders Boolean  @default(true)
  fileCount         Int      @default(0)
  status            String   @default("READY") // READY | DONE
  startedById       String?
  scannedAt         DateTime @default(now())

  startedBy User?        @relation(fields: [startedById], references: [id], onDelete: SetNull)
  items     ImportItem[]

  @@index([status])
}

/// A single file found by a scan, with the hub's guess at where it belongs.
model ImportItem {
  id           String    @id @default(cuid())
  batchId      String
  googleFileId String
  name         String
  mimeType     String?
  ownerEmail   String?
  webViewLink  String?
  folderPath   String?
  /// BigInt for the same reason as Document.sizeBytes: this is Drive's number
  /// for a file nobody vetted, and one oversized file must not fail the scan.
  sizeBytes    BigInt?
  modifiedAt   DateTime?

  guessedCategoryId   String?
  guessedProductionId String?
  /// 0–100. Only ever a hint; a human confirms before anything is filed.
  confidence          Int     @default(0)

  /// PENDING | FILED | SKIPPED | DUPLICATE
  decision   String  @default("PENDING")
  documentId String?
  createdAt  DateTime @default(now())

  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([batchId, googleFileId])
  @@index([decision])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Google connection & configuration
// ---------------------------------------------------------------------------

/// OAuth credentials for the dedicated Google account that owns every document
/// the hub creates. Refresh tokens are encrypted at rest (lib/crypto.ts).
/// Exactly one row, id = "singleton".
model DriveAccount {
  id                 String    @id @default("singleton")
  email              String
  name               String?
  accessToken        String? // encrypted
  refreshToken       String? // encrypted
  expiresAt          DateTime?
  scope              String?
  rootFolderId       String?
  productionsFolderId String?
  standingFolderId   String?
  connectedByUserId  String?
  connectedAt        DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  connectedBy User? @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
}

/// Single-row app configuration, id = "singleton".
model OrgConfig {
  id             String   @id @default("singleton")
  orgName        String   @default("Penn Players")
  /// The board's Google Group. No longer an access mechanism: board documents
  /// are shared with each member by name, taken from the member list, so that
  /// disabling somebody on the hub removes their Drive access too — which is
  /// impossible with a group, because the hub cannot read a consumer group's
  /// membership.
  ///
  /// Still recorded for two reasons: it is the address the board is written to,
  /// and a sharing sweep needs to know it in order to take the old group
  /// permission back off files that still carry one.
  groupEmail     String?
  /// Marks the start of a re-share sweep; documents shared before this are
  /// still stale. Lets a long sweep resume instead of timing out.
  sharingSweepStartedAt DateTime?
  /// Tokens: {production} {category} {title} {date} {season}
  namingTemplate String   @default("[{production}] {title} — {category}")
  driveRootName  String   @default("Penn Players Hub")
  currentSeason  String?
  stampDocHeader Boolean  @default(true)
  /// Whether the hub sends email at all. Off until an admin turns it on, so
  /// nothing is ever emailed by surprise.
  emailEnabled   Boolean  @default(false)
  lastDigestAt   DateTime?
  /// Where archived shows' folders are moved at season rollover.
  archiveFolderId String?
  lastRolloverAt  DateTime?
  /// Day of the week the digest goes out, 0 = Sunday. Null = never.
  digestDay          Int?
  /// Whether the scheduled run re-exports Canva mirrors that have fallen behind.
  canvaAutoRefresh   Boolean   @default(true)
  lastCronAt         DateTime?
  lastCanvaRefreshAt DateTime?
  /// How far the scheduled Drive check has read. Everything Google says
  /// changed after this has already been folded into the documents' edit
  /// times, so the next run only has to ask about what is newer.
  lastDriveScanAt    DateTime?
  /// When the naming rule was last applied across every existing title.
  /// Null means never, which is what triggers the one-off pass on a hub that
  /// predates the rule being used for hub titles at all.
  titlesNormalisedAt DateTime?
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // e.g. "document.create"
  targetType String? // "Document" | "User" | ...
  targetId   String?
  summary    String
  metadata   String? // JSON text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

/// An upload the hub has authorised but not yet finished.
///
/// The browser sends the bytes straight to Google (or to the mock endpoint),
/// which keeps large files out of our request path. The row exists so the
/// finish step can prove the file that showed up is the one we authorised:
/// `token` is written into the file's appProperties when the upload session is
/// opened, and checked again afterwards.
model PendingUpload {
  id            String   @id @default(cuid())
  token         String   @unique
  createdById   String
  /// JSON: the document metadata captured in the form.
  payload       String
  /// Set when this upload replaces the contents of an existing document.
  documentId    String?
  fileName      String
  driveName     String
  mimeType      String
  sizeBytes     Int?
  driveFolderId String?
  /// The Google resumable session URI. Kept server-side so the proxy fallback
  /// cannot be pointed at an arbitrary host.
  sessionUrl    String?
  status        String   @default("PENDING") // PENDING | COMPLETE | FAILED
  createdAt     DateTime @default(now())

  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([status])
}

/// A fixed-window rate limit counter.
///
/// Database-backed rather than in-memory because the app is meant to run on
/// serverless, where every request may be a fresh process and an in-memory
/// counter would protect nothing. One row per key per window; old rows are
/// swept opportunistically.
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String
  windowAt  DateTime
  count     Int      @default(0)

  @@unique([bucket, windowAt])
  @@index([windowAt])
}

/// Short-lived OAuth state, so the callback can verify the round trip.
///
/// `userId` is recorded for flows whose callback must not depend on a session
/// cookie: Canva refuses `localhost` redirect URIs, so its callback can land on
/// 127.0.0.1 where the cookie set on localhost is not sent.
model OAuthState {
  state        String   @id
  purpose      String // "login" | "drive" | "canva"
  redirect     String?
  userId       String?
  /// PKCE code_verifier, required by Canva's OAuth flow.
  codeVerifier String?
  createdAt    DateTime @default(now())
}

/// OAuth credentials for the hub's Canva account, which owns the exports.
/// Tokens are encrypted at rest (lib/crypto.ts). Exactly one row, id =
/// "singleton". Canva access tokens last ~4 hours and refresh tokens rotate on
/// every use, so both are rewritten as they are refreshed.
model CanvaAccount {
  id                String    @id @default("singleton")
  canvaUserId       String?
  canvaTeamId       String?
  displayName       String?
  accessToken       String? // encrypted
  refreshToken      String? // encrypted
  expiresAt         DateTime?
  scope             String?
  capabilities      String? // JSON array text
  connectedByUserId String?
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connectedBy User? @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
}
