# Copy to .env and fill in. See SETUP.md for where each value comes from.

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# --- Secrets ----------------------------------------------------------------
# openssl rand -base64 48
SESSION_SECRET=""
# openssl rand -base64 32  (used to encrypt the Google refresh token at rest)
APP_ENCRYPTION_KEY=""

# --- Google OAuth client (SETUP.md step 2) ----------------------------------
# Leave blank while evaluating locally: the hub then runs in mock Drive mode
# and no Google account is required.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Modes ------------------------------------------------------------------
# google = talk to the real Drive API.  mock = fake Drive, no network calls.
# auto   = google when GOOGLE_CLIENT_ID is set, otherwise mock.
DRIVE_MODE="auto"

# Lets you sign in as any seeded user without Google. NEVER enable in production.
ALLOW_DEV_LOGIN="true"

# Comma-separated emails promoted to ADMIN on seed / first sign-in.
BOOTSTRAP_ADMIN_EMAILS=""

# --- Canva (optional; SETUP.md stage 2i) ------------------------------------
# Canva cannot let the hub manage who opens a design, so the hub mirrors a
# design: it exports it and files the export in Drive, where the hub's own
# Private/Company/Board rules apply. Leave blank to run on a simulated Canva.
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# canva = talk to Canva. mock = simulate it. off = hide the feature. auto = pick.
CANVA_MODE="auto"
