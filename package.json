{
  "name": "penn-players-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "backup": "node --env-file=.env --import tsx scripts/export-metadata.ts",
    "restore": "node --env-file=.env --import tsx scripts/restore-metadata.ts",
    "rebuild": "node --env-file=.env --import tsx scripts/rebuild-from-drive.ts",
    "use-db": "node scripts/use-database.mjs",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "node --env-file=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@googleapis/docs": "^13.0.0",
    "@googleapis/drive": "^25.0.0",
    "@googleapis/forms": "^10.0.0",
    "@googleapis/gmail": "^21.0.0",
    "@googleapis/oauth2": "^9.0.0",
    "@googleapis/sheets": "^17.0.0",
    "@googleapis/slides": "^9.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.1.0",
    "google-auth-library": "^11.0.2",
    "jose": "^5.9.6",
    "lucide-react": "^1.39.0",
    "next": "^15.1.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
